# Conexão com o PostgreSQL (local: copie a URL "TCP" exibida por "npx prisma dev")
DATABASE_URL="postgres://USUARIO:SENHA@HOST:5432/BANCO"
# Segredo usado para assinar os tokens JWT (use uma frase longa e aleatória)
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
PORT=3333
# Endereço(s) do frontend autorizados pelo CORS, separados por vírgula
CORS_ORIGIN="http://localhost:5173"
# Usuário administrador criado pelo "npm run db:seed"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
