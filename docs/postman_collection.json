              "path": [
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipamentoId\": \"{{equipamentoId}}\",\n  \"inicio\": \"{{inicio}}\",\n  \"fim\": \"{{fim}}\",\n  \"finalidade\": \"Aula de Matemática\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
